generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Consulta {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  nombre    String
  empresa   String?
  email     String
  telefono  String?
  servicio  String
  mensaje   String?
  leida     Boolean  @default(false)
}